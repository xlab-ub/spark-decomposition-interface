# LLM provider: "openai" (commercial) or "vllm" (local vLLM server)
SPARK_LLM_PROVIDER=openai

# Commercial OpenAI (when SPARK_LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
SPARK_LLM_MODEL=gpt-4o-mini

# Local vLLM Docker (when SPARK_LLM_PROVIDER=vllm)
# docker run --gpus all -p 8000:8000 vllm/vllm-openai:latest --model openai/gpt-oss-20b
# Port-forward 8000 if the container runs on a remote GPU server.
# Use hosted_vllm/ prefix for local vLLM (LiteLLM routes via api_base automatically).
# Or use openai/gpt-oss-20b without prefix (custom_llm_provider derived as "openai").
SPARK_LLM_API_BASE=http://localhost:8000/v1
SPARK_LLM_MODEL=hosted_vllm/openai/gpt-oss-20b
SPARK_LLM_API_KEY=EMPTY

# LLM generation parameters
SPARK_LLM_TEMPERATURE=0.5
SPARK_LLM_TOP_P=0.9
# gpt-oss-20b needs headroom; 512 can return empty output (finish_reason=length)
SPARK_LLM_MAX_TOKENS=2048

# Rasa endpoints
RASA_SERVER_URL=http://localhost:15005
RASA_ACTIONS_PORT=15055
DUCKLING_URL=http://localhost:19999

# Web UI
WEB_SERVER_PORT=9999

# Feature flags (true/false)
SPARK_RASA_TEST=true
SPARK_WEB_SERVER=true
SPARK_TTS_ON=false
SPARK_DATABASE_ON=false
SPARK_FIND_SIMILAR=false
SPARK_GPT_WITH_LOCAL_LLM=true

# Robot backend: "noop" (default, no hardware) or "go1" (real Unitree Go1)
SPARK_ROBOT_BACKEND=noop

# Optional peripheral endpoints (only used when enabled in config)
SPARK_STT_URL=http://localhost:9009/transcribe
SPARK_TTS_URL=http://localhost:19099/synthesize
