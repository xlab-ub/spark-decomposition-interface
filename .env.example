# LLM provider: "openai" (commercial) or "vllm" (local vLLM server)
SPARK_LLM_PROVIDER=openai

# Commercial OpenAI (when SPARK_LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
SPARK_LLM_MODEL=gpt-4o-mini

# Local vLLM Docker (when SPARK_LLM_PROVIDER=vllm)
# docker run --gpus all -p 8000:8000 vllm/vllm-openai:latest --model openai/gpt-oss-20b
# Port-forward 8000 if the container runs on a remote GPU server.
# Use hosted_vllm/ prefix for local vLLM; the app strips it before sending the request.
# Or use openai/gpt-oss-20b without prefix (custom_llm_provider derived as "openai").
SPARK_LLM_API_BASE=http://localhost:8000/v1
SPARK_LLM_MODEL=hosted_vllm/openai/gpt-oss-20b
SPARK_LLM_API_KEY=EMPTY

# LLM generation parameters
SPARK_LLM_TEMPERATURE=0.5
SPARK_LLM_TOP_P=0.9
# gpt-oss-20b needs headroom; 512 can return empty output (finish_reason=length)
SPARK_LLM_MAX_TOKENS=2048

# Rasa endpoints
RASA_SERVER_URL=http://localhost:15005
RASA_ACTIONS_PORT=15055
DUCKLING_URL=http://localhost:19999

# Web UI
WEB_SERVER_PORT=9999

# Feature flags (true/false)
SPARK_RASA_TEST=true
SPARK_WEB_SERVER=true
SPARK_TTS_ON=false
SPARK_DATABASE_ON=false
SPARK_FIND_SIMILAR=false
SPARK_GPT_WITH_LOCAL_LLM=true

# Robot backend (see actions/robot/<robot>/): "noop" (default, Go1 vocabulary, no hardware) or "go1" (real Unitree Go1);
# g1 / g1_sim / g1_noop (Unitree G1), go2 / go2_sim / go2_noop (Unitree Go2), rb10_1300e / rb10_1300e_sim / rb10_1300e_noop (RB10-1300E).
# <robot> = real hardware, <robot>_sim = MuJoCo, <robot>_noop = dry run with that robot's vocabulary.
SPARK_ROBOT_BACKEND=noop

# Unitree Go2 real robot (SPARK_ROBOT_BACKEND=go2) - wired Ethernet DDS
# Requires: pip install cyclonedds==0.10.2 && pip install -e ~/unitree_sdk2_python --no-deps
# SPARK_GO2_IFACE=            # auto-detected from a 192.168.123.x address when unset
# SPARK_GO2_VX=0.3
# SPARK_GO2_VY=0.3
# SPARK_GO2_VYAW=0.5
# SPARK_GO2_MOVE_SECONDS=2.0
# SPARK_GO2_TURN_SECONDS=2.0
# SPARK_GO2_CAMERA=true       # front camera stream for the web UI (needs SPARK_RASA_TEST=false)
# SPARK_GO2_FIND_TIMEOUT=25.0 # FIND scan budget in seconds (rotate + detect)
# SPARK_GO2_NEAR_AREA=0.05    # target box area fraction treated as NEAR (tune on site)
# SPARK_GO2_CAMERA_DT=0.1

# Unitree G1 real robot (SPARK_ROBOT_BACKEND=g1) - wired DDS via unitree_sdk2py
# Enter NORMAL mode with the remote first: L2+B -> L2+Up -> R1+Y.
# SPARK_G1_IFACE=             # auto-detected from a 192.168.123.x address when unset
# SPARK_G1_VX=0.3
# SPARK_G1_VY=0.3
# SPARK_G1_VYAW=0.3
# SPARK_G1_MOVE_SECONDS=2.0
# SPARK_G1_TURN_SECONDS=2.0
# SPARK_G1_CAMERA=true        # head camera stream + detection for the web UI (needs SPARK_RASA_TEST=false)
# SPARK_G1_FIND_TIMEOUT=25.0  # FIND scan budget in seconds (rotate + detect)
# SPARK_G1_NEAR_AREA=0.05     # target box area fraction treated as NEAR (tune on site)

# Rainbow Robotics RB10-1300E (SPARK_ROBOT_BACKEND=rb10_1300e) - rbpodo over TCP
# Requires: pip install rbpodo pyrealsense2. REACH uses the hand-eye calibration
# actions/robot/rb10_1300e/cam_to_base.json (override with SPARK_RB10_CALIB;
# recalibrate and replace the file when the camera or robot base moves).
# SPARK_RB10_IP=192.168.0.100
# SPARK_RB10_DRY=false        # true = controller Simulation mode (arm does not move)
# SPARK_RB10_CAMERA=true      # RealSense stream + detection (needs SPARK_RASA_TEST=false)
# SPARK_RB10_NEAR_AREA=0.05
# SPARK_RB10_STEP_MM=50            # one MOVE_FORWARD/BACK/LEFT/RIGHT step
# SPARK_RB10_STEP_MM_VERTICAL=15   # one MOVE_UP/DOWN step (small near the table)
# SPARK_RB10_CALIB=           # path to cam_to_base.json when not next to the backend

# Optional peripheral endpoints (only used when enabled in config)
SPARK_STT_URL=http://localhost:9009/transcribe
SPARK_TTS_URL=http://localhost:19099/synthesize
